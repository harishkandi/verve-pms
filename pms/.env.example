# Copy to pms/.env (git-ignored) for local runs; on Render set the same names under Environment.

# Google sign-in + Calendar invites (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application").
# Authorised redirect URIs: http://localhost:3000/api/auth/google/callback, https://verve-pms.onrender.com/api/auth/google/callback,
# https://verve-pms.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string; signs sessions and encrypts stored calendar tokens. Changing it signs everyone out.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Become PMS admin on first Google sign-in (comma-separated)
ADMIN_EMAILS=

# Optional
# ORG_DOMAIN=verveadvisory.com      # only accounts on this Google Workspace domain can sign in
# DEMO_LOGIN=1                      # test accounts with a password (admin@, hr@, manager@, employee@ and ADMIN_EMAILS);
                                    # default: only when Google is not set up
# DEMO_PASSWORD=Verve@123           # the shared password for those test accounts
# APP_ORIGINS=http://localhost:3000,https://verve-pms.onrender.com,https://verve-pms.vercel.app
