{
  "name": "verve-pms",
  "version": "0.1.0",
  "private": true,
  "description": "Verve HRMS - Performance Management System (Google sign-in for the org domain, Calendar invites; Postgres when DATABASE_URL is set)",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env server.js",
    "db:reset": "node --env-file-if-exists=../.env.local db.js --reset",
    "employees": "node --env-file-if-exists=../.env.local employees.js",
    "local": "node --env-file-if-exists=.env server.js --local-state"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
